# Local: npm run setup generates two private accounts.
DATABASE_URL=file:.data/coffee.db
DATABASE_AUTH_TOKEN=
# Vercel Marketplace injects these automatically when connecting Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_USERNAME=administrador
ADMIN_PASSWORD_HASH=
OWNER_USERNAME=propietario
OWNER_PASSWORD_HASH=
# Production: Turso libsql URL + auth token and Vercel Blob token.
BLOB_READ_WRITE_TOKEN=
# Public canonical URL, without trailing slash. Optional locally.
NEXT_PUBLIC_SITE_URL=
